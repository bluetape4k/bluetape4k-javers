digraph "javers-kafka-projection-01" {
  graph [
    rankdir=LR,
    bgcolor="transparent",
    margin=0.2,
    nodesep=0.8,
    ranksep=1.0,
    splines=ortho
  ];

  node [
    shape=rect,
    style="rounded,filled",
    fontname="Architects Daughter",
    fontsize=18,
    margin="0.16,0.10",
    penwidth=2
  ];

  edge [
    fontname="Comic Mono",
    fontsize=12,
    color="#56708C",
    fontcolor="#536476",
    penwidth=2,
    arrowsize=0.8
  ];

  writer [label="Application\nwrite side", fillcolor="#E8F3FF", color="#75A9E8"];
  javers [label="JaVers", fillcolor="#EAF7EF", color="#69B888"];
  kafkaRepo [label="Kafka repository\nwrite-only", fillcolor="#FFF3D9", color="#D9AA4D"];
  topic [label="Kafka topic\nsnapshot stream", fillcolor="#FFFFFF", color="#D9AA4D"];
  projector [label="KafkaCdoSnapshotProjector\nreplay + idempotency", fillcolor="#F5EDFF", color="#A179D8"];
  readRepo [label="CdoSnapshotRepository\nRedis / Exposed / Caffeine", fillcolor="#E9F7F6", color="#45A7A1"];
  query [label="Application\nread side", fillcolor="#FBEAF0", color="#D87391"];

  writer -> javers [label="commit aggregate"];
  javers -> kafkaRepo [label="saveSnapshot"];
  kafkaRepo -> topic [label="encoded payload"];
  topic -> projector [label="poll partition+offset"];
  projector -> readRepo [label="save or skip existing"];
  query -> readRepo [label="history queries", dir=back, color="#D87391", fontcolor="#A14E68"];
}
