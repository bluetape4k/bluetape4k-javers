digraph javers_redis_sequence {
  graph [rankdir = LR, bgcolor = "transparent", nodesep = 0.55, ranksep = 0.75, splines = ortho];
  node [shape = box, style = "rounded,filled", color = "#9FB2C5", fillcolor = "#FFFFFF", fontname = "Helvetica", fontsize = 12];
  edge [color = "#56708C", penwidth = 2, arrowsize = 0.8];
  app [label = "Application", fillcolor = "#E8F3FF"];
  javers [label = "JaVers", fillcolor = "#EAF7EF"];
  repository [label = "Lettuce/Redisson\nCdoSnapshotRepository", fillcolor = "#E9F7F6"];
  redis [label = "Redis\nsnapshot lists + commit sequences", shape = cylinder, fillcolor = "#FFFFFF"];
  app -> javers [label = "commit aggregate"];
  javers -> repository [label = "saveSnapshot/loadSnapshots"];
  repository -> redis [label = "encoded snapshots"];
  redis -> repository [label = "history/head restore", style = dashed];
  repository -> javers [label = "CdoSnapshot list", style = dashed];
}
