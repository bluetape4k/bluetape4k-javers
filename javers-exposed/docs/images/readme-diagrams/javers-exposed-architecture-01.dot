digraph JaversExposedArchitecture {
  graph [rankdir=TB, bgcolor="transparent", splines=ortho, nodesep=0.7, ranksep=0.8];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12, margin="0.16,0.08"];
  edge [color="#56708C", penwidth=2, arrowsize=0.8, fontname="Arial", fontsize=10];

  application [label="Kotlin service", fillcolor="#E8F3FF", color="#75A9E8"];
  javers [label="JaVers runtime", fillcolor="#EAF7EF", color="#69B888"];
  repository [label="ExposedCdoSnapshotRepository", fillcolor="#FCE7F3", color="#DB7890"];
  base [label="AbstractCdoSnapshotRepository\nencode/decode, JQL fallback", fillcolor="#F1ECFF", color="#8A72D6"];
  schema [label="ensureSchema()\nSchemaUtils.create", fillcolor="#FFF3D9", color="#D9AA4D"];
  commit [label="CommitTable\njavers_commit", fillcolor="#FFFFFF", color="#DB7890"];
  snapshot [label="CdoSnapshotTable\njavers_snapshot", fillcolor="#FFFFFF", color="#DB7890"];
  db [label="Exposed JDBC Database\nH2 / PostgreSQL / MySQL", shape=cylinder, fillcolor="#E9F7F6", color="#45A7A1"];

  { rank=same; application; javers; }
  { rank=same; repository; base; }
  { rank=same; commit; snapshot; }

  application -> javers [label="commit/query"];
  javers -> repository [label="JaversRepository"];
  repository -> base [label="extends"];
  repository -> schema [label="schema bootstrap"];
  repository -> commit [label="commit metadata + sequence"];
  repository -> snapshot [label="encoded CdoSnapshot"];
  commit -> db;
  snapshot -> db;
}
