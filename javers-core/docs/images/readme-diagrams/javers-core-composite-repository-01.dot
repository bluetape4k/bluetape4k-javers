digraph CompositeCdoSnapshotRepository {
  graph [
    rankdir=LR,
    bgcolor="#fffdf8",
    pad="0.35",
    nodesep="0.95",
    ranksep="1.15",
    splines=polyline,
    labelloc=t,
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD><FONT FACE="Architects Daughter" POINT-SIZE="24">Composite CDO Snapshot Repository</FONT></TD></TR>
        <TR><TD><FONT FACE="Comic Mono" POINT-SIZE="13">Primary read source with ordered secondary fanout</FONT></TD></TR>
      </TABLE>
    >
  ];

  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#4a5568",
    fontname="Architects Daughter",
    fontsize=18,
    margin="0.18,0.12"
  ];

  edge [
    color="#596579",
    penwidth=1.8,
    arrowsize=0.8,
    fontname="Comic Mono",
    fontsize=12
  ];

  app [
    label="Application\nJaVers commit",
    fillcolor="#fdebd3"
  ];

  composite [
    label="CompositeCdoSnapshotRepository\nprimary-first fanout",
    fillcolor="#dff3ea"
  ];

  primary [
    label="Primary repository\nExposed / Redis / Caffeine",
    fillcolor="#dbeafe"
  ];

  redis [
    label="Secondary projection\nRedis cache store",
    fillcolor="#fce7f3"
  ];

  kafka [
    label="Secondary stream\nKafka write-only repository",
    fillcolor="#eee7ff"
  ];

  queries [
    label="JaVers reads\nquery source of truth",
    fillcolor="#e8f7d4"
  ];

  consumers [
    label="Downstream consumers\nreplay / audit pipeline",
    fillcolor="#fff2b8"
  ];

  app -> composite [label="persist(commit)", color="#2563eb"];
  composite -> primary [label="1. primary persist", color="#16a34a"];
  composite -> redis [color="#db2777"];
  composite -> kafka [color="#7c3aed"];
  queries -> composite [label="read methods", color="#64748b", dir=back];
  composite -> primary [label="delegate reads", color="#64748b"];
  kafka -> consumers [label="records", color="#7c3aed"];
}
