digraph exposed_ddd_sequence {
  graph [
    rankdir = LR,
    bgcolor = "transparent",
    nodesep = 0.55,
    ranksep = 0.75,
    splines = ortho
  ];
  node [
    shape = box,
    style = "rounded,filled",
    color = "#9FB2C5",
    fillcolor = "#FFFFFF",
    fontname = "Helvetica",
    fontsize = 12
  ];
  edge [color = "#56708C", penwidth = 2, arrowsize = 0.8];

  client [label = "Client", fillcolor = "#E8F3FF"];
  handler [label = "OrderCommandHandler", fillcolor = "#EAF7EF"];
  store [label = "Exposed order table", shape = cylinder, fillcolor = "#FFFFFF"];
  audit [label = "ExposedCdoSnapshotRepository", fillcolor = "#FCE7F3"];
  kafka [label = "Kafka topic", fillcolor = "#FFF3D9"];
  consumer [label = "OrderProjectionEventConsumer", fillcolor = "#E9F7F6"];
  redis [label = "Redis OrderSummary", shape = cylinder, fillcolor = "#FFFFFF"];
  query [label = "OrderQueryService", fillcolor = "#F1ECFF"];

  client -> handler [label = "PlaceOrderCommand"];
  handler -> store [label = "insert/update Order"];
  handler -> audit [label = "JaVers commit"];
  handler -> kafka [label = "OrderPlaced"];
  consumer -> kafka [label = "poll event", dir = back];
  consumer -> redis [label = "upsert OrderSummary"];
  client -> query [label = "findSummary(orderId)"];
  query -> redis [label = "get summary"];
  redis -> client [label = "OrderSummary", style = dashed];
}
