digraph javers_persistence_options {
    graph [
        rankdir = LR,
        bgcolor = "transparent",
        margin = 0.2,
        nodesep = 0.55,
        ranksep = 0.9
    ];

    node [
        shape = box,
        style = "rounded,filled",
        fontname = "Comic Mono",
        fontsize = 11,
        color = "#b8c2d6",
        fillcolor = "#ffffff"
    ];

    edge [
        color = "#6b7280",
        fontname = "Comic Mono",
        fontsize = 9,
        arrowsize = 0.8
    ];

    consumer [label = "Kotlin services\nJaVers audit/diff", fillcolor = "#e0f2fe"];
    core [label = "javers-core\nCdoSnapshotRepository\nAbstractCdoSnapshotRepository\nJaversCodec", fillcolor = "#eef2ff"];
    redis [label = "javers-persistence-redis\nLettuceCdoSnapshotRepository\nRedissonCdoSnapshotRepository", fillcolor = "#dcfce7"];
    kafka [label = "javers-persistence-kafka\nKafkaCdoSnapshotRepository\nwrite-only event stream", fillcolor = "#fef3c7"];
    exposed [label = "javers-exposed (#3)\nExposed JDBC repository\nSQL snapshots + commits", fillcolor = "#fce7f3"];
    bom [label = "bluetape4k-javers-bom\naligned artifacts", fillcolor = "#f1f5f9"];
    redis_store [label = "Redis\nsnapshot lists\ncommit sequences", shape = cylinder, fillcolor = "#d1fae5"];
    kafka_topic [label = "Kafka topic\nsnapshot events", shape = cylinder, fillcolor = "#fde68a"];
    sql_store [label = "Relational DB\njavers_snapshot\njavers_commit", shape = cylinder, fillcolor = "#fbcfe8"];

    consumer -> bom [label = "imports"];
    consumer -> core [label = "builds JaVers"];
    core -> redis [label = "extends SPI"];
    core -> kafka [label = "extends SPI"];
    core -> exposed [label = "planned SPI"];
    redis -> redis_store [label = "read/write"];
    kafka -> kafka_topic [label = "publish"];
    exposed -> sql_store [label = "read/write"];
}
