digraph module_composition {
  graph [
    rankdir = TB,
    bgcolor = "transparent",
    nodesep = 0.65,
    ranksep = 0.65
  ];
  node [
    shape = box,
    style = "rounded,filled",
    color = "#9FB2C5",
    fillcolor = "#FFFFFF",
    fontname = "Helvetica",
    fontsize = 12
  ];
  edge [color = "#56708C", penwidth = 2, arrowsize = 0.8];

  core [label = "javers-core", fillcolor = "#E8F3FF"];
  bom [label = "bluetape4k-javers-bom", fillcolor = "#F7F1E7"];
  ddd [label = "javers-ddd", fillcolor = "#EAF7EF"];
  exposed [label = "javers-exposed", fillcolor = "#FCE7F3"];
  adapters [label = "Redis and Kafka adapters", fillcolor = "#FFF3D9"];
  example [label = "examples/javers-exposed-ddd", fillcolor = "#E9F7F6"];

  { rank = same; core; bom; }
  { rank = same; ddd; exposed; adapters; }

  bom -> core [style = dashed, color = "#8A72D6"];
  core -> ddd;
  core -> exposed;
  core -> adapters;
  ddd -> example;
  exposed -> example;
  adapters -> example;
}
